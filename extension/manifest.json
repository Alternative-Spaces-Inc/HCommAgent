{
  "manifest_version": 3,
  "name": "Human Collections Agent",
  "version": "0.1.0",
  "key": "",
  "description": "Browser overlay surface for HCA: SSE inbox stream with a Chrome alarm fallback, native radio, checkbox, and approve/deny controls.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "identity"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "oauth2": {
    "client_id": "529822100897-kqt82297rvh559desb96e4ehp06fttka.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Human Collections Agent"
  },
  "options_page": "options.html"
}
