# Use python scripts/dev_setup.py to generate private local credentials.
# These placeholders intentionally fail production validation.
HCA_ENV=development
DATABASE_URL=sqlite:///./hca_local.db
HCA_ADMIN_TOKEN=GENERATE_LOCALLY
SWEEP_TRIGGER_TOKEN=GENERATE_LOCALLY
HCA_API_KEY_PEPPER=GENERATE_LOCALLY
HCA_REQUIRE_GOOGLE_LINK=0
HCA_GOOGLE_CLIENT_ID=
HCA_OWNER_EMAILS=
HCA_WEBHOOK_ENCRYPTION_KEYS={}
HCA_WEBHOOK_CURRENT_KEY_ID=
# HCA_WEBHOOK_ALLOW_INSECURE=1 is permitted ONLY for loopback development.
