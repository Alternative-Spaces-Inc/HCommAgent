# Reference only. Run python scripts/dev_setup.py to generate .env.development.
# Never copy these placeholders into a production environment.
HCA_ENV=development
DATABASE_URL=sqlite:///api/hca_development.db
HCA_ADMIN_TOKEN=GENERATE_LOCALLY
SWEEP_TRIGGER_TOKEN=GENERATE_LOCALLY
HCA_API_KEY_PEPPER=GENERATE_LOCALLY
HCA_REQUIRE_GOOGLE_LINK=0
HCA_GOOGLE_CLIENT_ID=
HCA_OWNER_EMAILS=
# The setup script uses loopback only. Production refuses this switch.
HCA_WEBHOOK_ALLOW_INSECURE=1
